# Seluruh nilai di bawah diisi di .env lokal atau di environment variables
# Vercel. Jangan pernah menaruh kunci sungguhan di berkas ini - berkas ini
# ikut ter-commit, .env tidak.

# Proyek Supabase yang SAMA dengan situs pembeli (lontar-papua). Dashboard
# tidak punya database sendiri: ia membaca tabel `orders` dan `order_items`
# yang ditulis server/api/orders.post.ts di sana.
# Ambil dari Supabase Dashboard > Project Settings > Data API > Project URL.
NUXT_PUBLIC_SUPABASE_URL=

# Publishable key (dulu bernama anon key).
# Project Settings > API Keys > publishable key (sb_publishable_...), atau
# `anon` di tab Legacy API keys bila proyek masih memakai kunci lama.
# Kunci ini ikut terkirim ke browser dan memang dirancang untuk itu: RLS di
# kedua tabel menolak seluruh akses lewat kunci ini, jadi ia hanya dipakai
# untuk login.
NUXT_PUBLIC_SUPABASE_KEY=

# Secret key - dipakai HANYA di server (server/api/*) untuk membaca pesanan.
# Project Settings > API Keys > secret key (sb_secret_...), atau `service_role`
# di tab Legacy API keys.
# Rahasia: kunci ini melewati seluruh RLS dan setara akses penuh ke database.
# Sama persis dengan NUXT_SUPABASE_SERVICE_ROLE_KEY di repo situs pembeli.
NUXT_SUPABASE_SECRET_KEY=

# Email yang boleh membuka dashboard, dipisah koma. Huruf besar-kecil
# diabaikan.
# WAJIB diisi: selama kosong, setiap permintaan ditolak - termasuk milikmu
# sendiri. Punya akun Supabase saja bukan izin masuk ke sini.
# Contoh: NUXT_ADMIN_EMAILS=wailan@contoh.com,dapur@contoh.com
NUXT_ADMIN_EMAILS=
